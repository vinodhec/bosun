# ── Frontend (Vite) ─────────────────────────────────────────────
# From Firebase console → Project settings → Your web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay public key id (safe to expose).
VITE_RAZORPAY_KEY_ID=

# Cloud Functions region.
VITE_FUNCTIONS_REGION=asia-south1

# GitHub App slug — used to build the "Connect my website" install link
# (https://github.com/apps/<slug>/installations/new). The install callback
# (a Cloud Function, built next) writes the connected repo to sites/{uid}.
VITE_GITHUB_APP_SLUG=

# NOTE: backend secrets (ANTHROPIC_API_KEY, RAZORPAY_SECRET, etc.) are NOT here.
# Set them on the Functions runtime — see functions/.env.example.
