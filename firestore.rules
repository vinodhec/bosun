rules_version = '2';

// Website-Fixer security rules.
// CRITICAL: money-bearing fields (balance, cost, charge) are written ONLY by the
// Cloud Functions Admin SDK, which bypasses these rules. Clients can READ their own
// data but can NEVER write balances, tasks, or transactions directly. This prevents
// a user from setting their own balance or forging a task's charged amount.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Membership: a user may belong to several orgs via the `orgIds` claim (an array). The
    // legacy single `orgId` claim is still accepted so the rollout is seamless for users whose
    // token hasn't been re-minted yet.
    function memberOf(oid) {
      return isSignedIn() && (
        (request.auth.token.orgIds != null && (oid in request.auth.token.orgIds)) ||
        request.auth.token.orgId == oid
      );
    }

    // User profile — read your own; all writes are backend-only.
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    // Organisation (holds the credit balance). Readable by members — scoped via the
    // `orgId` custom claim the operator sets when assigning a user. Writes are
    // backend-only (admin callables + billing).
    match /organisations/{orgId} {
      allow read:  if memberOf(orgId);
      allow write: if false;
    }

    // Org secrets (the operator-provisioned GitHub token). BACKEND-ONLY — clients can
    // neither read nor write. Functions reach it via the Admin SDK (bypasses rules).
    match /orgSecrets/{orgId} {
      allow read, write: if false;
    }

    // Tasks — owner-read; writes backend-only. The CUSTOMER UI never reads this directly:
    // it uses the listMySessions callable, which returns only safe fields (no PR link,
    // model, or raw API cost). Direct read stays scoped to the owner for the operator's
    // live-status views (Admin / Running / Result).
    match /tasks/{taskId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Features — a "plan a feature" request + its ordered steps. Owner-read; all writes are
    // backend-only (the planner debits the wallet for the breakdown, and the sequencer mutates
    // the steps). The customer UI reads features via the listMyFeatures callable, not directly.
    match /features/{featureId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Designs — a "design a screen" request: the clarify chat, the rendered mock image URLs, and
    // (after approval) the build task. Owner-read; all writes backend-only (the session finalizer
    // debits the wallet for the design phase and stores the mock URLs). The customer UI reads
    // designs via the listMyDesigns callable, not directly.
    match /designs/{designId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Comparisons — a "size up the competition" request: the clarify chat + the two-sided scorecard.
    // Owner-read; all writes backend-only (the session finalizer debits the wallet for the comparison
    // phase and stores the report). The customer UI reads comparisons via the listMyComparisons
    // callable, not directly.
    match /comparisons/{comparisonId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Chats — a "chat & build" session: the clarify chat, an optional preview mock, and (after the
    // owner approves) the built change. Owner-read; all writes backend-only (the session finalizer
    // debits the wallet ONCE on build completion). The customer UI reads chats via the listMyChats
    // callable, not directly.
    match /chats/{chatId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Transactions (credits/debits ledger) — org-scoped read; backend-only writes.
    match /transactions/{txnId} {
      allow read:  if memberOf(resource.data.orgId);
      allow write: if false;
    }

    // Tax invoices (issued on wallet top-ups) — org-scoped read; backend-only writes.
    // Same shape as transactions: a member reads their org's invoices; only the Admin SDK
    // (adminAddCredits) ever writes them. The `counters` doc that numbers them is fully
    // internal — clients never touch it (covered by the default-deny below).
    match /invoices/{invoiceId} {
      allow read:  if memberOf(resource.data.orgId);
      allow write: if false;
    }

    // Connected websites (GitHub repos). Doc id = owner uid in v1 (one site/user).
    // Read your own; the GitHub install callback writes it via the Admin SDK.
    match /sites/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    // Sourced-listing dedup ledger (which listing URLs we've already relayed per org). Purely
    // internal to the relay cron — BACKEND-ONLY, clients never touch it. The org sees its sourcing
    // charges through the owner-readable `transactions` (kind='sourcing'); the non-secret
    // `org.sourcing` config is readable under the `organisations` rule above, like `org.figma`.
    match /sourcingSeen/{orgId}/{doc=**} {
      allow read, write: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
