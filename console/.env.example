# Copy to ~/.config/agent-console.env (EC2) or export in a shell (laptop).
PORT=7000
HOST=127.0.0.1
REPO=/home/ec2-user/apps/maadiveedu-unified-platform
BASE_REF=origin/main
SESSIONS_DIR=/home/ec2-user/agent-sessions

# The account that runs turns. Log it in once: CLAUDE_CONFIG_DIR=<dir> claude
CLAUDE_CONFIG_DIR=/home/ec2-user/.claude-console
MODEL=sonnet

# = the platform's BOSUN_SOURCING_SECRET
CONSOLE_SECRET=
# Platform base URL to report our public URL to (POST /api/ingest/console-url)
PLATFORM_URL=https://www.maadiveedu.com
# EC2: discover a public URL via cloudflared. Laptop: PUBLIC_URL=http://localhost:7000 instead.
TUNNEL=1
# PUBLIC_URL=

# CONSOLE_ALLOWED_ORIGINS=https://www.maadiveedu.com https://maadiveedu.com https://mav30prod-maadiveedu.vercel.app http://localhost:3000 http://localhost:3100
# LOCAL_UI=1        # loopback fallback UI at /, unsigned session creation from loopback
# GUARD=off         # never on a shared box
IDLE_MINUTES=30
MAX_AGE_HOURS=6
MAX_TURNS=40
PR_LABEL=needs-validation
