[Unit]
Description=Agent console orchestrator (chat-and-code for maadiveedu-unified-platform)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/bosun/console
EnvironmentFile=%h/.config/agent-console.env
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/apps/bosun/console/server.mjs
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
